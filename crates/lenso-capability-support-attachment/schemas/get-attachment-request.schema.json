{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["organization_id", "case_ref", "attachment_id"],
  "properties": {
    "organization_id": { "$ref": "#/$defs/Opaque200" },
    "case_ref": { "$ref": "#/$defs/Opaque500" },
    "attachment_id": { "$ref": "#/$defs/Uuid" }
  },
  "additionalProperties": false,
  "$defs": {
    "Opaque200": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$" },
    "Opaque500": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$" },
    "Uuid": { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" }
  }
}
